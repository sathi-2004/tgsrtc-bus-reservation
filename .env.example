# =============================================================================
# TGSRTC Bus Reservation System - Environment Configuration Template
# =============================================================================
# INSTRUCTIONS:
# Copy this file to '.env' in your local environment for development/testing.
# NEVER commit your real '.env' file or production credentials to Git!
# =============================================================================

# --- Backend Server Configuration ---
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- MySQL Database Configuration ---
DB_URL=jdbc:mysql://localhost:3306/bus_reservation_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# --- JWT Security (Use a cryptographically secure random secret with >= 256 bits) ---
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_for_security!
JWT_EXPIRATION_MS=86400000

# --- Razorpay Payment Gateway (Keep KEY_SECRET strictly on the backend) ---
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# --- SMTP / Email Configuration (Optional) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password_here
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# --- Frontend Client Configuration (Vite) ---
# NOTE: Only public keys and base URLs may be exposed in frontend variables
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_NAME=TGSRTC Online Passenger Reservation System
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
